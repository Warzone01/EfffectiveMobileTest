<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/details_background_dark">

    <ProgressBar
        android:id="@+id/progress_details"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/layout_error"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/text_error"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Details.BodyMedium" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_retry"
            style="@style/Widget.Details.Button.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/details_action_button_height"
            android:layout_marginTop="@dimen/details_space_md"
            android:text="@string/details_retry" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/layout_content"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls"
        android:scrollbars="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <FrameLayout
                android:id="@+id/layout_cover"
                android:layout_width="0dp"
                android:layout_height="@dimen/details_cover_height"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:id="@+id/image_cover"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/details_cover"
                    android:scaleType="centerCrop"
                    android:src="@drawable/bg_details_cover_placeholder" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/details_gradient_height"
                    android:background="@drawable/bg_details_gradient_top" />

                <ImageButton
                    android:id="@+id/button_back"
                    android:layout_width="@dimen/details_floating_button_size"
                    android:layout_height="@dimen/details_floating_button_size"
                    android:layout_gravity="top|start"
                    android:layout_marginTop="@dimen/details_floating_button_top"
                    android:layout_marginStart="@dimen/details_screen_padding_horizontal"
                    android:background="@drawable/bg_details_floating_button"
                    android:contentDescription="@string/details_back"
                    android:elevation="4dp"
                    android:src="@drawable/ic_details_back" />

                <ImageButton
                    android:id="@+id/button_toggle_favorite"
                    android:layout_width="@dimen/details_floating_button_size"
                    android:layout_height="@dimen/details_floating_button_size"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="@dimen/details_floating_button_top"
                    android:layout_marginEnd="@dimen/details_screen_padding_horizontal"
                    android:background="@drawable/bg_details_floating_button"
                    android:contentDescription="@string/details_favorite"
                    android:elevation="4dp"
                    android:src="@drawable/selector_details_favorite_icon"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="22dp"
                    android:layout_gravity="bottom|start"
                    android:layout_marginStart="8dp"
                    android:layout_marginBottom="8dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_details_button_secondary"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_detail_star"
                            android:contentDescription="@null" />

                        <TextView
                            android:id="@+id/text_rate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:textAppearance="@style/TextAppearance.Details.Caption" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/text_date"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_marginStart="4dp"
                        android:background="@drawable/bg_details_button_secondary"
                        android:gravity="center_vertical"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"
                        android:textAppearance="@style/TextAppearance.Details.Caption" />
                </LinearLayout>

            </FrameLayout>

            <TextView
                android:id="@+id/text_title"
                android:layout_width="0dp"
                android:layout_height="@dimen/details_header_height"
                android:layout_marginStart="@dimen/details_screen_padding_horizontal"
                android:layout_marginEnd="@dimen/details_screen_padding_horizontal"
                android:gravity="center_vertical"
                android:textAppearance="@style/TextAppearance.Details.TitleLarge"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/layout_cover" />

            <LinearLayout
                android:id="@+id/layout_author"
                android:layout_width="0dp"
                android:layout_height="@dimen/details_author_row_height"
                android:layout_marginStart="@dimen/details_screen_padding_horizontal"
                android:layout_marginEnd="@dimen/details_screen_padding_horizontal"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/text_title">

                <ImageView
                    android:id="@+id/image_author_avatar"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_details_avatar"
                    android:contentDescription="@string/details_author_avatar" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/text_author_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/details_author_name"
                        android:textColor="@color/details_text_primary_50"
                        android:textAppearance="@style/TextAppearance.Details.Caption" />

                    <TextView
                        android:id="@+id/text_author_subtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/details_author_subtitle"
                        android:textAppearance="@style/TextAppearance.Details.TitleMedium" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layout_actions"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/details_space_3xl"
                android:layout_marginStart="@dimen/details_screen_padding_horizontal"
                android:layout_marginEnd="@dimen/details_screen_padding_horizontal"
                android:orientation="vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/layout_author">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_action"
                    style="@style/Widget.Details.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/details_action_button_height"
                    android:text="@string/details_action" />

                <com.google.android.material.button.MaterialButton
                    style="@style/Widget.Details.Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/details_action_button_height"
                    android:layout_marginTop="@dimen/details_space_sm"
                    android:text="@string/details_add_to_favorites" />
            </LinearLayout>

            <TextView
                android:id="@+id/text_about_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/details_space_2xl"
                android:layout_marginStart="@dimen/details_screen_padding_horizontal"
                android:layout_marginEnd="@dimen/details_screen_padding_horizontal"
                android:text="@string/details_about"
                android:textAppearance="@style/TextAppearance.Details.TitleLarge"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/layout_actions" />

            <TextView
                android:id="@+id/text_description"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/details_space_md"
                android:layout_marginStart="@dimen/details_screen_padding_horizontal"
                android:layout_marginEnd="@dimen/details_screen_padding_horizontal"
                android:textAppearance="@style/TextAppearance.Details.BodyMedium"
                android:textColor="@color/details_text_primary_70"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/text_about_title" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
