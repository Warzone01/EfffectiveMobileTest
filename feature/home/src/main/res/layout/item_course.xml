<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/course_card_root"
    android:layout_width="match_parent"
    android:layout_height="@dimen/home_course_card_height"
    android:background="@drawable/bg_home_card"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <ImageView
        android:id="@+id/course_cover"
        android:layout_width="0dp"
        android:layout_height="@dimen/home_course_cover_height"
        android:contentDescription="@string/home_course_cover"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_home_cover_placeholder"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/layout_meta_chips"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/home_course_meta_height"
        android:layout_marginStart="8dp"
        android:layout_marginBottom="8dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="@id/course_cover"
        app:layout_constraintStart_toStartOf="@id/course_cover">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="@drawable/bg_home_glass_chip"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="6dp">

            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/ic_home_star" />

            <TextView
                android:id="@+id/course_rate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:textAppearance="@style/TextAppearance.Home.Caption" />
        </LinearLayout>

        <TextView
            android:id="@+id/course_date"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_home_glass_chip"
            android:gravity="center_vertical"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:textAppearance="@style/TextAppearance.Home.Caption" />

    </LinearLayout>

    <ImageButton
        android:id="@+id/course_favorite"
        android:layout_width="@dimen/home_course_favorite_size"
        android:layout_height="@dimen/home_course_favorite_size"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/bg_home_favorite_button"
        android:contentDescription="@string/home_favorite"
        android:padding="6dp"
        android:src="@drawable/selector_home_favorite_icon"
        app:layout_constraintEnd_toEndOf="@id/course_cover"
        app:layout_constraintTop_toTopOf="@id/course_cover" />

    <TextView
        android:id="@+id/course_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:textAppearance="@style/TextAppearance.Home.TitleMedium"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/course_cover" />

    <TextView
        android:id="@+id/course_description"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textAppearance="@style/TextAppearance.Home.BodySmall"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/course_title" />

    <TextView
        android:id="@+id/course_price"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="8dp"
        android:textAppearance="@style/TextAppearance.Home.TitleMedium"
        app:layout_constraintEnd_toStartOf="@id/layout_more"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/course_description" />

    <LinearLayout
        android:id="@+id/layout_more"
        android:layout_width="wrap_content"
        android:layout_height="16dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/course_description">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/home_details"
            android:textAppearance="@style/TextAppearance.Home.LabelSmall"
            android:textColor="@color/home_primary_green" />

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_home_arrow_right" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
