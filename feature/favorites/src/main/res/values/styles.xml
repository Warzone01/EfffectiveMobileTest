<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="TextAppearance.Favorites.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">@dimen/favorites_text_title_large</item>
        <item name="android:textFontWeight">400</item>
        <item name="android:lineHeight">28sp</item>
        <item name="android:textColor">@color/favorites_text_primary</item>
    </style>

    <style name="TextAppearance.Favorites.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">@dimen/favorites_text_title_medium</item>
        <item name="android:textFontWeight">500</item>
        <item name="android:lineHeight">18sp</item>
        <item name="android:textColor">@color/favorites_text_primary</item>
    </style>

    <style name="TextAppearance.Favorites.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
