<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/home_background_dark">

    <TextView
        android:id="@+id/text_home_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/home_spacing_lg"
        android:layout_marginStart="@dimen/home_screen_horizontal_padding"
        android:layout_marginEnd="@dimen/home_screen_horizontal_padding"
        android:text="@string/home_title"
        android:textAppearance="@style/TextAppearance.Home.TitleLarge"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/layout_search_stub"
        style="@style/Widget.Home.SearchField"
        android:layout_width="@dimen/home_search_width"
        android:layout_height="@dimen/home_search_height"
        android:layout_marginTop="@dimen/home_top_controls_top"
        android:layout_marginStart="@dimen/home_screen_horizontal_padding"
        android:hint="@string/home_search_stub"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:startIconDrawable="@drawable/ic_home_search"
        app:startIconTint="@color/home_text_primary"
        app:startIconMinSize="@dimen/home_search_icon_container">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edit_search_stub"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:enabled="false"
            android:focusable="false"
            android:inputType="none"
            android:textAppearance="@style/TextAppearance.Home.BodyMedium"
            android:textColor="@color/home_text_primary"
            android:textColorHint="@color/home_text_primary_50" />
    </com.google.android.material.textfield.TextInputLayout>

    <ImageButton
        android:id="@+id/button_filter_stub"
        android:layout_width="@dimen/home_filter_size"
        android:layout_height="@dimen/home_filter_size"
        android:layout_marginTop="@dimen/home_top_controls_top"
        android:layout_marginEnd="@dimen/home_screen_horizontal_padding"
        android:background="@drawable/bg_home_filter_button"
        android:contentDescription="@string/home_filter_stub"
        android:enabled="false"
        android:src="@drawable/ic_home_filter"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_sort"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/home_sort_top"
        android:layout_marginEnd="@dimen/home_screen_horizontal_padding"
        android:backgroundTint="@android:color/transparent"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:padding="0dp"
        android:text="@string/home_sort"
        android:textAllCaps="false"
        android:textAppearance="@style/TextAppearance.Home.BodyMedium"
        android:textColor="@color/home_primary_green"
        app:icon="@drawable/ic_home_sort"
        app:iconGravity="textEnd"
        app:iconPadding="@dimen/home_spacing_xs"
        app:iconTint="@color/home_primary_green"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_home"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/home_recycler_top"
        android:clipToPadding="false"
        android:paddingStart="@dimen/home_screen_horizontal_padding"
        android:paddingEnd="@dimen/home_screen_horizontal_padding"
        android:paddingBottom="@dimen/home_spacing_lg"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
