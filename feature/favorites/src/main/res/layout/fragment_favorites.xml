<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/favorites_background_dark">

    <TextView
        android:id="@+id/text_favorites_title"
        android:layout_width="0dp"
        android:layout_height="@dimen/favorites_header_height"
        android:layout_marginTop="@dimen/favorites_header_top"
        android:layout_marginStart="@dimen/favorites_screen_padding_horizontal"
        android:layout_marginEnd="@dimen/favorites_screen_padding_horizontal"
        android:gravity="center_vertical"
        android:text="@string/favorites_title"
        android:textAppearance="@style/TextAppearance.Favorites.TitleLarge"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_favorites"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/favorites_list_top"
        android:clipToPadding="false"
        android:paddingStart="@dimen/favorites_screen_padding_horizontal"
        android:paddingEnd="@dimen/favorites_screen_padding_horizontal"
        android:paddingBottom="@dimen/favorites_item_spacing"
        android:scrollbars="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
